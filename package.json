{
  "name": "jira-ai",
  "displayName": "jira-ai",
  "version": "0.0.1",
  "description": "Browser extension for JournalistBoost platform",
  "author": "FAJB Team",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:chrome": "plasmo build --target=chrome-mv3",
    "build:firefox": "plasmo build --target=firefox-mv3"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "plasmo": "^0.90.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.62.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@plasmohq/storage": "^1.13.1",
    "@types/chrome": "^0.0.304",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3"
  },
  "manifest": {
    "background": {
      "service_worker": "src/background.ts"
    },
    "host_permissions": [
      "https://*/*",
      "http://localhost:3000/*"
    ],
    "permissions": [
      "cookies",
      "storage",
      "tabs",
      "notifications"
    ]
  }
}
